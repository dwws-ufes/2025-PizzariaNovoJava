<?xml version="1.0"?>
<rdf:RDF xmlns="http://localhost:8081/pizzaria/"
     xml:base="http://localhost:8081/pizzaria/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="http://localhost:8081/pizzaria/">
        <rdfs:label>Ontologia da Pizzaria</rdfs:label>
        <rdfs:comment>Ontologia para sistema de gestão de pizzaria com integração semântica</rdfs:comment>
    </owl:Ontology>
    
    <!-- ========================================
         CLASSES PRINCIPAIS
         ======================================== -->
    
    <!-- Pizza -->
    <owl:Class rdf:about="http://localhost:8081/pizzaria/Pizza">
        <rdfs:label>Pizza</rdfs:label>
        <rdfs:comment>Classe que representa uma pizza no sistema</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://schema.org/Product"/>
    </owl:Class>
    
    <!-- Bebida -->
    <owl:Class rdf:about="http://localhost:8081/pizzaria/Bebida">
        <rdfs:label>Bebida</rdfs:label>
        <rdfs:comment>Classe que representa uma bebida no sistema</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://schema.org/Product"/>
    </owl:Class>
    
    <!-- Cliente -->
    <owl:Class rdf:about="http://localhost:8081/pizzaria/Cliente">
        <rdfs:label>Cliente</rdfs:label>
        <rdfs:comment>Classe que representa um cliente da pizzaria</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://schema.org/Person"/>
    </owl:Class>
    
    <!-- Usuario -->
    <owl:Class rdf:about="http://localhost:8081/pizzaria/Usuario">
        <rdfs:label>Usuário</rdfs:label>
        <rdfs:comment>Classe que representa um funcionário/usuário do sistema</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://schema.org/Person"/>
    </owl:Class>
    
    <!-- Pedido -->
    <owl:Class rdf:about="http://localhost:8081/pizzaria/Pedido">
        <rdfs:label>Pedido</rdfs:label>
        <rdfs:comment>Classe que representa um pedido no sistema</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://schema.org/Order"/>
    </owl:Class>
    
    <!-- ItemPedido -->
    <owl:Class rdf:about="http://localhost:8081/pizzaria/ItemPedido">
        <rdfs:label>Item do Pedido</rdfs:label>
        <rdfs:comment>Classe que representa um item específico de um pedido</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://schema.org/OrderItem"/>
    </owl:Class>
    
    <!-- Pagamento -->
    <owl:Class rdf:about="http://localhost:8081/pizzaria/Pagamento">
        <rdfs:label>Pagamento</rdfs:label>
        <rdfs:comment>Classe que representa um pagamento no sistema</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://schema.org/PaymentMethod"/>
    </owl:Class>
    
    <!-- ========================================
         PROPRIEDADES ESPECÍFICAS DA PIZZARIA
         ======================================== -->
    
    <!-- Propriedades para Pizza -->
    <owl:DatatypeProperty rdf:about="http://localhost:8081/pizzaria/tamanho">
        <rdfs:label>Tamanho</rdfs:label>
        <rdfs:comment>Tamanho da pizza (0=PEQUENA, 1=MEDIA, 2=GRANDE, 3=FAMILIA)</rdfs:comment>
        <rdfs:domain rdf:resource="http://localhost:8081/pizzaria/Pizza"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://localhost:8081/pizzaria/qtdFatias">
        <rdfs:label>Quantidade de Fatias</rdfs:label>
        <rdfs:comment>Número de fatias da pizza</rdfs:comment>
        <rdfs:domain rdf:resource="http://localhost:8081/pizzaria/Pizza"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    
    <!-- Propriedades para Bebida -->
    <owl:DatatypeProperty rdf:about="http://localhost:8081/pizzaria/volume">
        <rdfs:label>Volume</rdfs:label>
        <rdfs:comment>Volume da bebida em litros</rdfs:comment>
        <rdfs:domain rdf:resource="http://localhost:8081/pizzaria/Bebida"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://localhost:8081/pizzaria/tipoBebida">
        <rdfs:label>Tipo de Bebida</rdfs:label>
        <rdfs:comment>Tipo da bebida (0=REFRIGERANTE, 1=SUCO, 2=AGUA, etc.)</rdfs:comment>
        <rdfs:domain rdf:resource="http://localhost:8081/pizzaria/Bebida"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    
    <!-- Propriedades gerais -->
    <owl:DatatypeProperty rdf:about="http://localhost:8081/pizzaria/cpf">
        <rdfs:label>CPF</rdfs:label>
        <rdfs:comment>Número do CPF</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://localhost:8081/pizzaria/ativo">
        <rdfs:label>Ativo</rdfs:label>
        <rdfs:comment>Indica se o registro está ativo no sistema</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://localhost:8081/pizzaria/tipoProduto">
        <rdfs:label>Tipo de Produto</rdfs:label>
        <rdfs:comment>Tipo do produto (0=PIZZA, 1=BEBIDA, 2=SOBREMESA)</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    
    <!-- Propriedades de relacionamento -->
    <owl:ObjectProperty rdf:about="http://localhost:8081/pizzaria/atendente">
        <rdfs:label>Atendente</rdfs:label>
        <rdfs:comment>Usuário que atendeu o pedido</rdfs:comment>
        <rdfs:domain rdf:resource="http://localhost:8081/pizzaria/Pedido"/>
        <rdfs:range rdf:resource="http://localhost:8081/pizzaria/Usuario"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://localhost:8081/pizzaria/perfil">
        <rdfs:label>Perfil</rdfs:label>
        <rdfs:comment>Perfil de acesso do usuário</rdfs:comment>
        <rdfs:domain rdf:resource="http://localhost:8081/pizzaria/Usuario"/>
    </owl:ObjectProperty>
    
    <!-- Propriedades de pagamento -->
    <owl:DatatypeProperty rdf:about="http://localhost:8081/pizzaria/desconto">
        <rdfs:label>Desconto</rdfs:label>
        <rdfs:comment>Valor do desconto aplicado</rdfs:comment>
        <rdfs:domain rdf:resource="http://localhost:8081/pizzaria/Pagamento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://localhost:8081/pizzaria/valorFinal">
        <rdfs:label>Valor Final</rdfs:label>
        <rdfs:comment>Valor final após desconto</rdfs:comment>
        <rdfs:domain rdf:resource="http://localhost:8081/pizzaria/Pagamento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="http://localhost:8081/pizzaria/formaPagamento">
        <rdfs:label>Forma de Pagamento</rdfs:label>
        <rdfs:comment>Forma de pagamento utilizada</rdfs:comment>
        <rdfs:domain rdf:resource="http://localhost:8081/pizzaria/Pagamento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    
    <owl:ObjectProperty rdf:about="http://localhost:8081/pizzaria/pedido">
        <rdfs:label>Pedido</rdfs:label>
        <rdfs:comment>Pedido relacionado ao pagamento</rdfs:comment>
        <rdfs:domain rdf:resource="http://localhost:8081/pizzaria/Pagamento"/>
        <rdfs:range rdf:resource="http://localhost:8081/pizzaria/Pedido"/>
    </owl:ObjectProperty>
    
    <owl:DatatypeProperty rdf:about="http://localhost:8081/pizzaria/login">
        <rdfs:label>Login</rdfs:label>
        <rdfs:comment>Login do usuário no sistema</rdfs:comment>
        <rdfs:domain rdf:resource="http://localhost:8081/pizzaria/Usuario"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
</rdf:RDF>
