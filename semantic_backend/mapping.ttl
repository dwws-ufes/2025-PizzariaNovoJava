# ========================================
# MAPEAMENTO PEDIDOS
# ========================================

<#PedidoTriplesMap>
    rr:logicalTable [ rr:tableName "pedido" ] ;
    rr:subjectMap [
        rr:template "http://localhost:8081/pizzaria/pedido/{id}" ;
        rr:class schema:Order, pizzaria:Pedido
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:identifier ;
        rr:objectMap [ rr:column "id" ; rr:datatype xsd:long ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:customer ;
        rr:objectMap [ 
            rr:template "http://localhost:8081/pizzaria/cliente/{cliente_id}" ;
            rr:termType rr:IRI 
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate pizzaria:atendente ;
        rr:objectMap [ 
            rr:template "http://localhost:8081/pizzaria/usuario/{atendente_id}" ;
            rr:termType rr:IRI 
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:orderStatus ;
        rr:objectMap [ rr:column "status" ; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:orderDate ;
        rr:objectMap [ rr:column "data_hora" ; rr:datatype xsd:dateTime ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:description ;
        rr:objectMap [ rr:column "observacoes" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate pizzaria:ativo ;
        rr:objectMap [ rr:column "ativo" ; rr:datatype xsd:boolean ]
    ] .

# ========================================
# MAPEAMENTO ITENS DO PEDIDO
# ========================================

<#ItemPedidoTriplesMap>
    rr:logicalTable [ rr:tableName "item_pedido" ] ;
    rr:subjectMap [
        rr:template "http://localhost:8081/pizzaria/item-pedido/{id}" ;
        rr:class schema:OrderItem, pizzaria:ItemPedido
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:identifier ;
        rr:objectMap [ rr:column "id" ; rr:datatype xsd:long ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:orderItemFor ;
        rr:objectMap [ 
            rr:template "http://localhost:8081/pizzaria/pedido/{pedido_id}" ;
            rr:termType rr:IRI 
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:orderedItem ;
        rr:objectMap [ 
            rr:template "http://localhost:8081/pizzaria/produto/{produto_id}" ;
            rr:termType rr:IRI 
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:orderQuantity ;
        rr:objectMap [ rr:column "quantidade" ; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:price ;
        rr:objectMap [ rr:column "valor_item" ; rr:datatype xsd:double ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate pizzaria:ativo ;
        rr:objectMap [ rr:column "ativo" ; rr:datatype xsd:boolean ]
    ] .

