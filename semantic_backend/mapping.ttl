@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix schema: <http://schema.org/> .
@prefix ex:     <http://example.org/produto#> .

<#ProdutoMapping>
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:tableName "produto" ] ;
    rr:subjectMap         [ rr:template "http://localhost:8080/api/produto/{id}" ;
                            rr:class    schema:Product ; ] ;
    rr:predicateObjectMap [ rr:predicate schema:name ;
                            rr:objectMap [ rr:column "nome" ] ] ;
    rr:predicateObjectMap [ rr:predicate schema:description ;
                            rr:objectMap [ rr:column "descricao" ] ] ;
    rr:predicateObjectMap [ rr:predicate schema:price ;
                            rr:objectMap [ rr:column "preco_venda" ] ] ;
    rr:predicateObjectMap [ rr:predicate schema:category ;
                            rr:objectMap [ rr:column "tipo_produto" ] ] .
