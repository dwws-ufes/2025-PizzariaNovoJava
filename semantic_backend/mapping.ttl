@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix schema: <http://schema.org/> .
@prefix ex: <http://example.org/pizza#> .

<#PizzaMapping>
    a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "pizza" ] ;

    rr:subjectMap [
          rr:template "http://example.org/pizza/{id}" ;
          rr:class <http://schema.org/Pizza> ;
      ] ;

    rr:predicateObjectMap [
          rr:predicate <http://schema.org/name> ;
          rr:objectMap [ rr:column "nome" ]
      ] ;

    rr:predicateObjectMap [
          rr:predicate <http://schema.org/description> ;
          rr:objectMap [ rr:column "descricao" ]
      ] .

