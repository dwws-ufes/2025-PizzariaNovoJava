        rr:objectMap [ rr:column "id" ; rr:datatype xsd:long ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate pizzaria:pedido ;
        rr:objectMap [ 
            rr:template "http://localhost:8081/pizzaria/pedido/{pedido_id}" ;
            rr:termType rr:IRI 
