@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix pizzaria: <http://localhost:8081/pizzaria/> .

# ========================================
# MAPEAMENTO PRODUTOS (Classe Pai)
# ========================================

<#ProdutoTriplesMap>
    rr:logicalTable [ rr:tableName "produto" ] ;
    rr:subjectMap [
        rr:template "http://localhost:8081/pizzaria/produto/{id}" ;
        rr:class schema:Product
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:identifier ;
        rr:objectMap [ rr:column "id" ; rr:datatype xsd:long ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:name ;
        rr:objectMap [ rr:column "nome" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:description ;
        rr:objectMap [ rr:column "descricao" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:price ;
        rr:objectMap [ rr:column "preco_venda" ; rr:datatype xsd:double ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate pizzaria:tipoProduto ;
        rr:objectMap [ rr:column "tipo_produto" ; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate pizzaria:ativo ;
        rr:objectMap [ rr:column "ativo" ; rr:datatype xsd:boolean ]
    ] .

# ========================================
# MAPEAMENTO PIZZAS (Herança de Produto)
# ========================================

<#PizzaTriplesMap>
    rr:logicalTable [ 
        rr:sqlQuery """
            SELECT p.id, p.nome, p.descricao, p.preco_venda, p.tipo_produto, p.ativo,
                   pz.tamanho, pz.qtd_fatias
            FROM produto p 
            INNER JOIN pizza pz ON p.id = pz.id 
            WHERE p.tipo_produto = 0
        """
    ] ;
    rr:subjectMap [
        rr:template "http://localhost:8081/pizzaria/pizza/{id}" ;
        rr:class schema:Product, pizzaria:Pizza
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:identifier ;
        rr:objectMap [ rr:column "id" ; rr:datatype xsd:long ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:name ;
        rr:objectMap [ rr:column "nome" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:description ;
        rr:objectMap [ rr:column "descricao" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:price ;
        rr:objectMap [ rr:column "preco_venda" ; rr:datatype xsd:double ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate pizzaria:tamanho ;
        rr:objectMap [ rr:column "tamanho" ; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate pizzaria:qtdFatias ;
        rr:objectMap [ rr:column "qtd_fatias" ; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate pizzaria:ativo ;
        rr:objectMap [ rr:column "ativo" ; rr:datatype xsd:boolean ]
    ] ;
    # Link para DBpedia baseado no nome da pizza
    rr:predicateObjectMap [
        rr:predicate schema:sameAs ;
        rr:objectMap [ 
            rr:template "http://dbpedia.org/resource/{nome}" ;
            rr:termType rr:IRI 
        ]
    ] .

# ========================================
# MAPEAMENTO BEBIDAS (Herança de Produto)
# ========================================

<#BebidaTriplesMap>
    rr:logicalTable [ 
        rr:sqlQuery """
            SELECT p.id, p.nome, p.descricao, p.preco_venda, p.tipo_produto, p.ativo,
                   b.volume, b.fabricante, b.tipo_bebida
            FROM produto p 
            INNER JOIN bebida b ON p.id = b.id 
            WHERE p.tipo_produto = 1
        """
    ] ;
    rr:subjectMap [
        rr:template "http://localhost:8081/pizzaria/bebida/{id}" ;
        rr:class schema:Product, pizzaria:Bebida
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:identifier ;
        rr:objectMap [ rr:column "id" ; rr:datatype xsd:long ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:name ;
        rr:objectMap [ rr:column "nome" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:description ;
        rr:objectMap [ rr:column "descricao" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:price ;
        rr:objectMap [ rr:column "preco_venda" ; rr:datatype xsd:double ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate pizzaria:volume ;
        rr:objectMap [ rr:column "volume" ; rr:datatype xsd:double ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:manufacturer ;
        rr:objectMap [ rr:column "fabricante" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate pizzaria:tipoBebida ;
        rr:objectMap [ rr:column "tipo_bebida" ; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate pizzaria:ativo ;
        rr:objectMap [ rr:column "ativo" ; rr:datatype xsd:boolean ]
    ] .

